<ui:FluentWindow x:Class="WinStart.Installer.InstallerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="WinStart Setup"
                 Width="680" Height="500" ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica" WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="TitleBar" Height="40" Title="WinStart Setup">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Width="16" Height="16" Source="pack://application:,,,/Assets/WinTweak.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="34,10,34,28">
            <StackPanel x:Name="WelcomePage" VerticalAlignment="Center">
                <TextBlock x:Name="WelcomeTitle" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="WelcomeSubtitle" FontSize="14" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="21" />

                <TextBlock x:Name="LocationLabel" FontSize="13" FontWeight="SemiBold" Margin="0,28,0,8"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="LocationBox" Grid.Column="0" />
                    <ui:Button x:Name="BrowseButton" Grid.Column="1" Margin="8,0,0,0" Click="OnBrowse" />
                </Grid>

                <CheckBox x:Name="DesktopCheck" Margin="0,18,0,0" IsChecked="True" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,34,0,0">
                    <ui:Button x:Name="CancelButton" Appearance="Secondary" Margin="0,0,10,0" Click="OnCancel" MinWidth="110" />
                    <ui:Button x:Name="UninstallButton" Appearance="Secondary" Margin="0,0,10,0" Click="OnUninstall"
                               MinWidth="130" Visibility="Collapsed" />
                    <ui:Button x:Name="InstallButton" Appearance="Primary" Click="OnInstall" MinWidth="150" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ProgressPage" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="ProgressTitle" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                <ProgressBar x:Name="Bar" Height="6" Margin="0,26,0,10" Minimum="0" Maximum="100" />
                <TextBlock x:Name="ProgressStage" FontSize="13" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel x:Name="FinishPage" VerticalAlignment="Center" Visibility="Collapsed">
                <ui:SymbolIcon x:Name="FinishIcon" Symbol="CheckmarkCircle48" FontSize="52"
                               HorizontalAlignment="Center" Foreground="#2FA65A" />
                <TextBlock x:Name="FinishTitle" FontSize="22" FontWeight="Bold" Margin="0,14,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="FinishText" FontSize="14" Margin="0,8,0,0" TextAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <CheckBox x:Name="RunCheck" Margin="0,22,0,0" IsChecked="True" HorizontalAlignment="Center" />
                <ui:Button x:Name="FinishButton" Appearance="Primary" Margin="0,26,0,0"
                           HorizontalAlignment="Center" MinWidth="150" Click="OnFinish" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-2,0,0">
                <ui:Button x:Name="ThemeButton" Appearance="Transparent" Padding="8,4" Click="OnToggleTheme"
                           Icon="{ui:SymbolIcon WeatherMoon24}" />
                <Border Width="1" Height="16" Margin="8,0" VerticalAlignment="Center"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock Text="RU" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:ToggleSwitch x:Name="LangToggle" Click="OnToggleLang" />
                <TextBlock Text="EN" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Canvas x:Name="Intro" ClipToBounds="True" Background="{DynamicResource ApplicationBackgroundBrush}">
                <TextBlock x:Name="WordMark" Text="WinStart" FontSize="34" FontWeight="Bold" Opacity="0">
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="WordScale" ScaleX="0.9" ScaleY="0.9" />
                    </TextBlock.RenderTransform>
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#2C7FD4" />
                            <GradientStop Offset="0.5" Color="#4FA3FF" />
                            <GradientStop Offset="1" Color="#7B5CFF" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <Rectangle x:Name="TrailLine" Height="2" Width="0" RadiusX="1" RadiusY="1">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#002C7FD4" />
                            <GradientStop Offset="0.5" Color="#FF4FA3FF" />
                            <GradientStop Offset="1" Color="#007B5CFF" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.Effect><BlurEffect Radius="2" /></Rectangle.Effect>
                </Rectangle>
            </Canvas>
        </Grid>
    </Grid>
</ui:FluentWindow>
