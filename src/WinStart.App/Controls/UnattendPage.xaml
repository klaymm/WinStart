<UserControl x:Class="WinStart.App.Controls.UnattendPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:WinStart.App.Infrastructure">

    <UserControl.Resources>
        <Style x:Key="TocItem" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Mark" Grid.Column="0" Width="3" CornerRadius="1.5" Margin="-6,2,7,2"
                                        Background="{DynamicResource SystemAccentColorSecondaryBrush}" Opacity="0" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                           Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Mark" Property="Opacity" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CardSubtle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBox x:Name="SearchBox" Width="240" Margin="0,0,10,0" Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="{loc:Text ua.search}" ClearButtonEnabled="True"
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Appearance="Secondary" Command="{Binding ResetCommand}"
                           Content="{loc:Text ua.reset}" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,0,8,0" />
                <ui:Button Appearance="Secondary" Command="{Binding PreviewCommand}"
                           Content="{loc:Text ua.preview}" Icon="{ui:SymbolIcon Code24}" Margin="0,0,8,0" />
                <ui:Button Appearance="Primary" Command="{Binding SaveCommand}"
                           Content="{loc:Text ua.save}" Icon="{ui:SymbolIcon Save24}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0" Padding="0,0,6,0">
                <StackPanel>
                    <Button Click="OnTocTopClick" Cursor="Hand" HorizontalAlignment="Stretch" Background="Transparent"
                            Visibility="{Binding IsFiltering, Converter={StaticResource InvertBoolToVisibility}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,5">
                                    <TextBlock Text="{loc:Text ua.check.title}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <ItemsControl x:Name="Toc" ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TocItem}" Click="OnTocClick"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="FormScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="4,0,10,0"
                          ScrollChanged="OnScrollChanged">
                <StackPanel>
                    <Border x:Name="ImageCard" Style="{StaticResource SoftCard}" Margin="0,0,0,12"
                            Visibility="{Binding IsFiltering, Converter={StaticResource InvertBoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Text ua.check.title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="{loc:Text ua.check.desc}" Style="{StaticResource UaDesc}" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="{loc:Text ua.check.placeholder}" Margin="0,0,8,0" />
                                <ui:Button Grid.Column="1" Appearance="Secondary" Command="{Binding BrowseImageCommand}"
                                           Content="{loc:Text ua.check.browse}" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,0" />
                                <ui:Button Grid.Column="2" Appearance="Primary" Command="{Binding CheckImageCommand}"
                                           Content="{loc:Text ua.check.check}" Icon="{ui:SymbolIcon Search24}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding ImageLines}" Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" FontSize="15" VerticalAlignment="Top" Margin="0,1,0,0">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Info24" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                                <Setter Property="Foreground" Value="#2FA65A" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                                <Setter Property="Symbol" Value="Warning24" />
                                                                <Setter Property="Foreground" Value="#E0A03E" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" HorizontalAlignment="Left" Margin="2,0,0,8"
                                             Visibility="{Binding IsCheckingImage, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="{loc:Text ua.usb.title}" Style="{StaticResource UaSubTitle}" Margin="0,6,0,4" />
                            <TextBlock Text="{loc:Text ua.usb.desc}" Style="{StaticResource UaDesc}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" MinWidth="220" Margin="0,0,8,0" />
                                <ui:Button Appearance="Secondary" Command="{Binding RefreshDrivesCommand}"
                                           Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="{loc:Text ua.usb.refresh}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Secondary" Command="{Binding CheckDriveCommand}"
                                           Content="{loc:Text ua.usb.check}" Icon="{ui:SymbolIcon Search24}" Margin="0,0,8,0" />
                                <ui:Button Appearance="Secondary" Command="{Binding WriteToDriveCommand}"
                                           Content="{loc:Text ua.usb.write}" Icon="{ui:SymbolIcon UsbStick24}" />
                            </StackPanel>
                            <TextBlock Text="{loc:Text ua.usb.none}" Style="{StaticResource UaDesc}" Margin="0,6,0,0"
                                       Visibility="{Binding HasDrives, Converter={StaticResource InvertBoolToVisibility}}" />
                            <TextBlock Text="{Binding DriveStatus}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding DriveStatus, Converter={StaticResource NullToVisibility}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2FA65A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DriveStatusIsError}" Value="True">
                                                <Setter Property="Foreground" Value="#E0483E" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="FormList" ItemsSource="{Binding Sections}" />

                    <TextBlock Text="{loc:Text ua.search.empty}" Style="{StaticResource UaDesc}" Margin="6,12,0,0"
                               Visibility="{Binding NothingFound, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="12.5" Margin="6,8,6,0" TextWrapping="Wrap"
                   Visibility="{Binding StatusText, Converter={StaticResource NullToVisibility}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#2FA65A" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="#E0483E" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
