<UserControl x:Class="WinStart.App.Controls.TextPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:WinStart.App.Infrastructure"
             Width="820" Height="520">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="Body" Grid.Row="0" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <ui:Button Appearance="Secondary" Click="OnCopy" Icon="{ui:SymbolIcon Copy24}"
                       Content="{loc:Text preview.copy}" />
            <TextBlock x:Name="Copied" Text="{loc:Text preview.copied}" FontSize="12.5" Margin="12,0,0,0"
                       VerticalAlignment="Center" Foreground="#2FA65A" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
