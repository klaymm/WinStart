<UserControl x:Class="WinStart.App.Controls.LiquidGlassIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False">
    <Canvas>
        <Grid x:Name="Glass" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="StretchScale" />
                    <ScaleTransform x:Name="JellyScale" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Border CornerRadius="12" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                      Opacity="0.13" Color="#1A2B4A" />
                </Border.Effect>
            </Border>

            <Border CornerRadius="12" Opacity="0.09" Background="{DynamicResource AccentFillColorDefaultBrush}">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="1" Color="#26000000" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>

            <Border CornerRadius="12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#59FFFFFF" />
                        <GradientStop Offset="0.45" Color="#12FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border x:Name="Sheen" CornerRadius="12" Opacity="0.45">
                <Border.Background>
                    <RadialGradientBrush x:Name="SheenBrush" Center="0.3,0" GradientOrigin="0.3,0"
                                         RadiusX="0.42" RadiusY="0.95">
                        <GradientStop Offset="0" Color="#80FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <Border CornerRadius="12" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" />
            <Border CornerRadius="11" BorderThickness="1" Margin="1">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                        <GradientStop Offset="0" Color="#B3FFFFFF" />
                        <GradientStop Offset="0.5" Color="#1AFFFFFF" />
                        <GradientStop Offset="1" Color="#4DFFFFFF" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>

            <Rectangle x:Name="Pill" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                       Fill="{DynamicResource AccentFillColorDefaultBrush}"
                       RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="PillScale" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </Canvas>
</UserControl>
