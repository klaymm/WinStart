<UserControl x:Class="WinStart.App.Controls.ProfileCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360">
    <StackPanel>
        <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,16" />

        <Border x:Name="Avatar" Width="88" Height="88" CornerRadius="44" HorizontalAlignment="Center">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#36B8FF" />
                    <GradientStop Offset="1" Color="#0A6BD6" />
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="{Binding Initial}" FontSize="40" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                   Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock x:Name="RoleText" Text="{Binding Role}" FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,16"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ItemsControl x:Name="SpecsList" ItemsSource="{Binding Specs}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8"
                            Padding="12,10" Margin="4" Loaded="Tile_Loaded">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
