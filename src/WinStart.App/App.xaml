<Application x:Class="WinStart.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/Styles/Styles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Styles/Templates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="Transparent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
